# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis (db 0 = Celery broker/results, db 1 = cache)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
PLAN_LIST_CACHE_TTL=300

# Celery
CELERY_TASK_ALWAYS_EAGER=False
EXPIRY_TASK_EVERY_MINUTES=5

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Payments
PAYMENT_CURRENCY=NGN
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_WEBHOOK_VERIFY_SIGNATURE=True

# Email (console = prints emails in the worker terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=billing@marketplace.local

LOG_LEVEL=INFO
